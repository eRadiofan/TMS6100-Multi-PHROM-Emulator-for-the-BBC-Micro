  130 IF RTPE%=&AA THEN PRINT "PHROM ID (0,4,10,15)";
  140 IF RTPE%<>&AA AND STW%=232 THEN PRINT "PHROM ID (0,2,4,10,15)";
  150 IF RTPE%<>&AA AND STW%<>232 THEN PRINT "PHROM ID (0,2,4,15)";
  160 INPUT RN%
  170 BN% = 1
  180 IF RN% = 2 THEN BN%=0:MAX%=148:PROCINITDATA
  190 IF RN% = 0 AND RTPE%=&AA THEN PROCTI99INDEX:BN%=0:MAX%=373
  200 IF RN% = 0 AND RTPE% <> &AA THEN MAX%=206
  210 IF RN% = 10 MAX%=23
  220 IF RN% = 15 THEN BN% = 32:MAX% = 260:PRINT "Phrase Acorn = 129"
  230 IF RN% = 4 THEN MAX% = 35
  240 LAST% = 1
  250 PRINT"<RETURN> = Previous, -1 = All"
  260 REPEAT
  270   PRINT "Phrase number (1-";MAX%;")";
  280   INPUT PN%
  290   IF (PN% = 0) THEN PN% = LAST%
  300   IF PN% = -1 THEN PROCALL(RN%,BN%,MAX%-1) ELSE PROCPHRASE(RN%,BN%+PN%-1)
  310   LAST% = PN%
  320 UNTIL 0
  330
  340 DEFPROCPHRASE(RN%,PN%)
  350 AN% = -1
  360 IF RTPE%=&AA AND RN%=0 THEN AN%=IDX99%(PN%)
  370 IF RN%=2 THEN AN%=IDXDATA%(PN%)
  380 REM PRINT PN%, ~AN%
  390 IF (AN% > &4000) THEN RN%=RN%+1:AN%=AN%-&4000
  400 IF AN% >= 0 THEN PROCSETADDR(RN%,AN%):PROCSPEAK ELSE PROCPHRASE_D(RN%,PN%)
  410 ENDPROC
  420
  430 DEF PROCALL(RN%,BN%,MAX%)
  440 FOR I% = 0 TO MAX%
  450   PRINT "Phrase ";I%+1
  460   PROCPHRASE(RN%,BN%+I%)
  470   PROCWAITEOS
  480   FOR J%=0 TO 1000:NEXT
  490 NEXT
  500 ENDPROC
  510
  520 DEF FNREVERSE(A%)
  530 =USR(REVERSE) AND &FF
  540
  550 DEF FNREAD
  560 CALL RDP
  570 =?RDAT%
  580
  590 DEF PROCWAITEOS
  600 REPEAT
  610   CALL RDS
  620   STAT% = ?RDAT%
  630 UNTIL (STAT% AND &80) = 0
  640 ENDPROC
  650
  660 DEF PROCSETADDR(RN%,PA%)
  670 DTA1%?0=&40+(PA% AND &000F)
  680 DTA1%?1=&40+((PA% AND &00F0) DIV 16)
  690 DTA1%?2=&40+((PA% AND &0F00) DIV 256)
  700 DTA1%?3=&40+(RN% AND 3)*4+((PA% AND &3000) DIV &1000)
  710 DTA1%?4=&40+(RN% AND 12)/4
  720 CALL SETADDR
  730 ENDPROC
  740
  750 DEF PROCSPEAK
  760 Y%=&50:CALL CMD
  770 ENDPROC
  780
  790 DEF PROCPHRASE_D(RN%,PN%)
  800 PA%=2 * PN%
  810 PROCSETADDR(RN%,PA%)
  820 LO% = FNREVERSE(FNREAD)
  830 HI% = FNREVERSE(FNREAD)
  840 PA% = LO% + 256*HI%
  850 PROCSETADDR(RN%,PA%)
  860 PROCSPEAK
  870 ENDPROC
  880
  890 DEF PROCPHRASE_I(RN%,PN%)
  900 PA%=2 * PN%
  910 PROCSETADDR(RN%,PA%)
  920 Y%=&30:CALL CMD
