 1090 DEF PROCasm
 1100 DIM CODE% 170
 1110 DIM DTA1% 5
 1120 DIM PPTR% 4
 1130 DIM IADR% 4
 1140 DIM RDAT% 1
 1150 FOR N=0 TO 2 STEP 2
 1160   P%=CODE%
 1170   [OPTN
 1180   .REVERSE STA &80
 1190   ROL &80:ROR A
 1200   ROL &80:ROR A
 1210   ROL &80:ROR A
 1220   ROL &80:ROR A
 1230   ROL &80:ROR A
 1240   ROL &80:ROR A
 1250   ROL &80:ROR A
 1260   ROL &80:ROR A
 1270   RTS
 1280   .SETADDR LDA #&9F
 1290   LDX #0
 1300   .LOOP1
 1310   LDY DTA1%,X
 1320   JSR &FFF4
 1330   INX:CPX #5
 1340   BNE LOOP1
 1350   RTS
 1360   .CMD LDA#&9F  \ Exec CMD in Y
 1370   JSR &FFF4
 1380   RTS
 1390   .RDP LDA #&9F \ Read command
 1400   LDY #&10
 1410   JSR &FFF4
 1420   .RDS          \ Return st/data
 1430   LDA #&9E
 1440   JSR &FFF4
 1450   STY RDAT%
 1460   RTS
 1470   .TIDX JSR RDP \ Get word len
 1480   TYA
 1490   CLC:ADC IADR% \ Add to pointer
 1500   BCC TIDX2
 1510   INC IADR%+1
 1520   CLC
 1530   .TIDX2 ADC #6 \ Add another 6
 1540   STA IADR%
 1550   BCC IADDR
 1560   INC IADR%+1
 1570   .IADDR:TAY    \ JMP CMD
 1580   AND #&F
 1590   ORA #&40
 1600   STA DTA1%     \ LoB Lo Nyb
 1610   TYA
 1620   LSR A:LSR A:LSR A:LSR A
 1630   ORA #&40
 1640   STA DTA1%+1   \ LoB Hi Nyb
 1650   LDA IADR%+1
 1660   TAY
 1670   AND #&F
 1680   ORA #&40
 1690   STA DTA1%+2   \ HiB Lo Nyb
 1700   TYA
 1710   LSR A:LSR A:LSR A:LSR A
 1720   ORA #&40
 1730   STA DTA1%+3   \ Hib Hi Nyb
 1740   LDA #&40
 1750   STA DTA1%+4   \ Bank 0
 1760   LDA IADR%
 1770   CLC:ADC #3    \ Inc Addr to next
 1780   STA IADR%
 1790   LDA IADR%+1
 1800   ADC #0
 1810   STA IADR%+1
 1820   JSR SETADDR   \ Go to Ptr Addr
 1830   JSR RDP:STY PPTR%+1
 1840   JSR RDP:STY PPTR%
 1850   JMP RDP       \ Go next byte
 1860   ]:NEXT:REM PRINT P%-CODE%
 1870 ENDPROC
